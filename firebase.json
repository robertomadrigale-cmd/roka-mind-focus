{
  "functions": {
    "source": "functions"
  },
  "firestore": [
    {
      "database": "rokazenfull",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      "**/node_modules/**",
      "functions/**",
      "debug_*",
      "catch_error.js",
      "puppeteer_screenshot.js",
      "fix_*.py",
      "refactor_*.py",
      "*.png",
      "deployed-firestore.rules"
    ],
    "rewrites": [
      {
        "source": "/api/ai",
        "function": {
          "functionId": "ai",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "**/*.@(js|html|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0"
          }
        ]
      }
    ]
  }
}
