rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /chatThreads/{threadId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /reports/{reportId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /sync/{docId} {
        allow get, list, create, update, delete: if request.auth != null
          && request.auth.uid == userId
          && docId in ['collections', 'singletons', 'counters'];
      }

      match /days/{dayId} {
        allow get, list: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if request.auth != null
          && request.auth.uid == userId
          && dayId.matches('^\\d{4}-\\d{2}-\\d{2}$');
      }

      match /backups/{backupId} {
        allow get, list, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }

      match /aiUsage/{usageId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
